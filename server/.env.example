# =========================================================================
# AUTOGUARD ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# Server Environment
PORT=5000
NODE_ENV=production
SERVE_CLIENT=true

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/guardconnect

# JWT Authentication
JWT_SECRET=your_minimum_32_character_cryptographically_secure_random_key_here
JWT_EXPIRE=7d

# Plivo Telephony Credentials (Optional: simulated fallback available)
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=+919876543210
PLIVO_WEBHOOK_BASE_URL=https://your-domain.com

# Automated Shift Call Scheduler Configuration
DEFAULT_VERIFICATION_INTERVAL_MINUTES=30
RETRY_INTERVAL_MINUTES=5
MAX_RETRY_ATTEMPTS=2
TIMEZONE=Asia/Kolkata

# Production CORS Security (Comma-separated trusted origins; NO wildcards with credentials)
# In production, specify your exact frontend domain(s)
ALLOWED_ORIGINS=https://autoguard.yourdomain.com,https://app.yourdomain.com

# Reverse Proxy & HTTPS Transport
TRUST_PROXY=1
ENABLE_HSTS=true

# Automated Database Backup Configuration
ENABLE_DAILY_BACKUP=true
BACKUP_DIR=../backups
BACKUP_RETENTION_DAYS=7
